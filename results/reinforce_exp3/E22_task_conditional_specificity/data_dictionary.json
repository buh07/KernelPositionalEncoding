          "description": "task id"
        },
        {
          "name": "metric",
          "dtype": "str",
          "description": "primary metric used"
        },
        {
          "name": "arm",
          "dtype": "str",
          "description": "true/permuted/normmatched/distortion_matched"
        },
        {
          "name": "trial",
